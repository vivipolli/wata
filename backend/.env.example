# Hedera Configuration
HEDERA_ACCOUNT_ID=0.0.123456
HEDERA_PRIVATE_KEY=your-hedera-private-key
# Required: testnet or mainnet. The backend refuses to start with any other value.
HEDERA_NETWORK=testnet

# Contract Configuration
CONTRACT_OWNER_PRIVATE_KEY=your-contract-owner-private-key
CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
ORACLE_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_PATH=/tmp/wata.db
DATABASE_URL="file:./data/wata.db"

# Oracle Configuration
ORACLE_PRIVATE_KEY=your-oracle-private-key
ORACLE_ADDRESS=0x1234567890123456789012345678901234567890

# Authentication & Security
# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# CORS Configuration
# Comma-separated exact origins (no wildcards). Localhost origins are added automatically
# only when NODE_ENV=development.
ALLOWED_ORIGINS=https://wata-mu.vercel.app

# Reverse-proxy hops to trust for client IP (Railway: 1). Never 'true'.
TRUST_PROXY_HOPS=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Security Headers
HELMET_CSP_ENABLED=true
HELMET_HSTS_ENABLED=true